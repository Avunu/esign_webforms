{
	"name": "esign",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"build": "vite build && node scripts/vite-register.mjs",
		"npx-upgrade": "npx npm-check-updates -u && yarn install",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:css": "stylelint \"esign/public/**/*.scss\"",
		"typecheck": "tsc --build tsconfig.json",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s lint:css && yarn -s typecheck"
	},
	"dependencies": {
		"@fontsource/caveat": "^5.3.0",
		"@fontsource/dancing-script": "^5.3.0",
		"@fontsource/great-vibes": "^5.3.0",
		"@fontsource/pacifico": "^5.3.0",
		"hast-util-to-dom": "^4.0.1",
		"signature_pad": "^5.1.4"
	},
	"devDependencies": {
		"@types/hast": "^3.0.4",
		"@types/node": "^26.6.4",
		"frappe-types": "^16.5.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.87.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
