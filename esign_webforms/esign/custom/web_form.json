{
  "custom_fields": [
    {
      "dt": "Web Form",
      "fieldname": "esign_enabled",
      "fieldtype": "Check",
      "insert_after": "login_required",
      "is_system_generated": 0,
      "label": "Enable eSign",
      "module": "eSign",
      "name": "Web Form-esign_enabled"
    },
    {
      "depends_on": "eval:doc.esign_enabled==1",
      "dt": "Web Form",
      "fieldname": "esign_section_break",
      "fieldtype": "Section Break",
      "insert_after": "allow_delete",
      "is_system_generated": 0,
      "label": "eSign Settings",
      "module": "eSign",
      "name": "Web Form-esign_section_break"
    },
    {
      "dt": "Web Form",
      "fieldname": "esign_submit_on_response",
      "fieldtype": "Check",
      "insert_after": "esign_section_break",
      "is_system_generated": 0,
      "label": "Submit on Response",
      "module": "eSign",
      "name": "Web Form-esign_submit_on_response"
    },
    {
      "description": "If enabled, users can only sign the document using a mobile device. Displays a QR code on desktop devices.",
      "dt": "Web Form",
      "fieldname": "esign_force_mobile",
      "fieldtype": "Check",
      "insert_after": "esign_submit_on_response",
      "is_system_generated": 0,
      "label": "Only allow Signing on Mobile",
      "module": "eSign",
      "name": "Web Form-esign_force_mobile"
    },
    {
      "dt": "Web Form",
      "fieldname": "esign_column_break",
      "fieldtype": "Column Break",
      "insert_after": "esign_force_mobile",
      "is_system_generated": 0,
      "module": "eSign",
      "name": "Web Form-esign_column_break"
    },
    {
      "dt": "Web Form",
      "fieldname": "esign_update_field",
      "fieldtype": "Select",
      "insert_after": "esign_column_break",
      "is_system_generated": 0,
      "label": "Set Property After Response",
      "module": "eSign",
      "name": "Web Form-esign_update_field"
    },
    {
      "dt": "Web Form",
      "fieldname": "esign_update_value",
      "fieldtype": "Data",
      "insert_after": "esign_update_field",
      "is_system_generated": 0,
      "label": "Value To Be Set",
      "module": "eSign",
      "name": "Web Form-esign_update_value"
    },
    {
      "depends_on": "eval:doc.esign_enabled==1",
      "dt": "Web Form",
      "fieldname": "esign_signer_section",
      "fieldtype": "Section Break",
      "insert_after": "esign_update_value",
      "is_system_generated": 0,
      "label": "Signer",
      "module": "eSign",
      "name": "Web Form-esign_signer_section"
    },
    {
      "description": "The form field the signer types their name into. Its value is recorded as the signer's name in the audit trail.",
      "dt": "Web Form",
      "fieldname": "esign_signer_name_field",
      "fieldtype": "Select",
      "insert_after": "esign_signer_section",
      "is_system_generated": 0,
      "label": "Signer Name Field",
      "module": "eSign",
      "name": "Web Form-esign_signer_name_field"
    },
    {
      "default": "0",
      "description": "Sign only through a link emailed to the signer, which binds their address to the document. The form's email field is filled from the link and cannot be changed, and the audit trail records the address as verified. Send for eSign sends each recipient their own link.",
      "dt": "Web Form",
      "fieldname": "esign_require_verified_email",
      "fieldtype": "Check",
      "insert_after": "esign_signer_name_field",
      "is_system_generated": 0,
      "label": "Require Verified Email",
      "module": "eSign",
      "name": "Web Form-esign_require_verified_email"
    },
    {
      "dt": "Web Form",
      "fieldname": "esign_signer_column_break",
      "fieldtype": "Column Break",
      "insert_after": "esign_require_verified_email",
      "is_system_generated": 0,
      "module": "eSign",
      "name": "Web Form-esign_signer_column_break"
    },
    {
      "description": "The form field the signer types their email into. A valid address in it is recorded as the signer's email in the audit trail.",
      "dt": "Web Form",
      "fieldname": "esign_signer_email_field",
      "fieldtype": "Select",
      "insert_after": "esign_signer_column_break",
      "is_system_generated": 0,
      "label": "Signer Email Field",
      "module": "eSign",
      "name": "Web Form-esign_signer_email_field"
    },
    {
      "description": "The consent the signer ticks before signing, recorded in the audit trail. Leave empty for: I agree to sign this document electronically.",
      "dt": "Web Form",
      "fieldname": "esign_consent_text",
      "fieldtype": "Small Text",
      "insert_after": "esign_signer_email_field",
      "is_system_generated": 0,
      "label": "Consent Text",
      "module": "eSign",
      "name": "Web Form-esign_consent_text"
    },
    {
      "depends_on": "eval:doc.esign_enabled==1",
      "dt": "Web Form",
      "fieldname": "esign_notification_section",
      "fieldtype": "Section Break",
      "insert_after": "esign_consent_text",
      "is_system_generated": 0,
      "label": "Notification Settings",
      "module": "eSign",
      "name": "Web Form-esign_notification_section"
    },
    {
      "description": "Send a notification after the document is signed, with the validated signed PDF attached.",
      "dt": "Web Form",
      "fieldname": "esign_send_notification",
      "fieldtype": "Check",
      "insert_after": "esign_notification_section",
      "is_system_generated": 0,
      "label": "Send Notification on Response",
      "module": "eSign",
      "name": "Web Form-esign_send_notification"
    },
    {
      "depends_on": "eval:doc.esign_send_notification==1",
      "description": "Select a Notification with Event set to 'Custom' for the same DocType. The signed PDF will be attached instead of regenerating the print.",
      "dt": "Web Form",
      "fieldname": "esign_notification",
      "fieldtype": "Link",
      "insert_after": "esign_send_notification",
      "is_system_generated": 0,
      "label": "Notification",
      "module": "eSign",
      "name": "Web Form-esign_notification",
      "options": "Notification"
    }
  ],
  "doctype": "Web Form",
  "property_setters": [
    {
      "doc_type": "Web Form",
      "doctype_or_field": "DocField",
      "field_name": "print_format",
      "is_system_generated": 0,
      "module": "eSign",
      "name": "Web Form-print_format-depends_on",
      "property": "depends_on",
      "property_type": "Code",
      "value": "eval:doc.esign_enabled||doc.allow_print"
    }
  ],
  "sync_on_migrate": 1
}
